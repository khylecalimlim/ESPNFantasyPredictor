# Copy to .env and fill in real values. .env is gitignored — never commit real credentials.

# Cookies from an ESPN Fantasy browser session (DevTools > Storage/Application > Cookies
# > fantasy.espn.com), needed by espn_api to read private-league data.
ESPN_S2=
SWID=

# League IDs (numeric, from the league's ESPN URL).
LEAGUE_ID_LAST_YEAR=
LEAGUE_ID_CURRENT=
SEASON_YEAR_LAST=
